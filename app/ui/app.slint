// SPDX-License-Identifier: GPL-3.0-or-later
import { Theme } from "theme.slint";
import { Section, Divider } from "components/section.slint";
import { TuneSlider } from "components/tune-slider.slint";
import { Segmented } from "components/segmented.slint";
import { Chip } from "components/chip.slint";
import { Toggle } from "components/toggle.slint";
import { Banner } from "components/banner.slint";
import { NumberField } from "components/number-field.slint";

export { Theme }

/// Which screen the window shows.
export enum Screen { searching, unsupported, permission, busy, error, connected }

/// One LED. `effect` is -1 while unknown; `brightness` is a percentage.
export struct LedData {
    id: int,
    name: string,
    effect: int,
    brightness: int,
    status: string,
    status-is-error: bool,
}

export component MainWindow inherits Window {
    title: "MouseTune for DeathAdder Essential";
    icon: @image-url("../../assets/icon-256.png");
    background: Theme.surface;
    // A fixed size: switching screens must never resize the window (on
    // macOS that left the drawing surface out of sync with the frame).
    // Content scrolls if the window is made smaller.
    min-width: 420px;
    min-height: 420px;
    preferred-width: 460px;
    preferred-height: 720px;

    in property <Screen> screen: Screen.searching;
    in property <string> message;
    in property <string> model-name;
    in property <string> firmware;
    in property <string> serial;
    in-out property <float> dpi-x: 800;
    in-out property <float> dpi-y: 800;
    in-out property <bool> separate-xy: false;
    in property <string> dpi-status;
    in property <bool> dpi-status-is-error;
    in property <int> polling-index: -1;
    in property <string> polling-status;
    in property <bool> polling-status-is-error;
    in property <[LedData]> leds;
    /// Bumped by the app on every worker event; sliders drop local edits.
    in property <int> epoch;
    /// Preferred height of the current screen (used by the snapshot tool).
    out property <length> content-height: content.preferred-height;

    callback apply-dpi(int, int);
    callback apply-polling(int);
    callback apply-effect(int, int);
    callback apply-brightness(int, int);
    callback open-settings();
    callback request-access();

    private property <[float]> presets: [400, 800, 1600, 3200, 6400];

    scroll := Flickable {
        viewport-height: Math.max(content.preferred-height, self.height);

    content := VerticalLayout {
        width: scroll.width;
        height: scroll.viewport-height;

        if root.screen == Screen.searching: Banner {
            icon: @image-url("icons/mouse.svg");
            pulse: true;
            title: "Connect your DeathAdder Essential";
            body: "Plug in the mouse. MouseTune finds it automatically.";
        }
        if root.screen == Screen.unsupported: Banner {
            icon: @image-url("icons/mouse-off.svg");
            attention: true;
            title: "This mouse isn't supported";
            body: "MouseTune works with the DeathAdder Essential only.";
        }
        if root.screen == Screen.permission: Banner {
            icon: @image-url("icons/lock.svg");
            title: "Allow Input Monitoring";
            body: "macOS needs your permission before MouseTune can talk to the mouse. In System Settings, open Privacy & Security → Input Monitoring, switch MouseTune on, then reopen the app.";
            action: "Open System Settings";
            activated => {
                root.request-access();
                root.open-settings();
            }
        }
        if root.screen == Screen.busy: Banner {
            icon: @image-url("icons/alert.svg");
            attention: true;
            title: "Another app is using the mouse";
            body: "Quit Razer Synapse or any other mouse utility, then unplug the mouse and plug it back in.";
        }
        if root.screen == Screen.error: Banner {
            icon: @image-url("icons/alert.svg");
            attention: true;
            title: "Couldn't talk to the mouse";
            body: root.message + "\nUnplug the mouse and plug it back in. MouseTune will retry.";
        }

        if root.screen == Screen.connected: VerticalLayout {
            // Pack sections to the top; a tall window must not stretch them apart.
            alignment: start;
            padding: Theme.page-pad;
            padding-bottom: Theme.page-pad - Theme.section-pad;

            // Header
            HorizontalLayout {
                padding-bottom: Theme.section-pad;
                spacing: 12px;
                Image {
                    source: @image-url("../../assets/logo/mousetune-symbol-black.svg");
                    colorize: Theme.accent;
                    width: 34px;
                    height: 34px;
                    y: 4px;
                    accessible-role: none;
                }
                VerticalLayout {
                    spacing: 3px;
                    Text {
                        text: root.model-name;
                        color: Theme.text;
                        font-size: Theme.font-title;
                        font-weight: 600;
                        accessible-role: text;
                    }
                    Text {
                        text: root.serial == "" ? "Firmware " + root.firmware : "Firmware " + root.firmware + "  ·  Serial " + root.serial;
                        color: Theme.text-muted;
                        font-size: Theme.font-small;
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: start;
                    padding-top: 4px;
                    HorizontalLayout {
                        alignment: end;
                        spacing: 6px;
                        Rectangle {
                            width: 8px;
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: Theme.success;
                            }
                        }
                        Text {
                            text: "Connected";
                            color: Theme.text-muted;
                            font-size: Theme.font-small;
                            vertical-alignment: center;
                            accessible-role: text;
                        }
                    }
                }
            }
            Divider { }

            Section {
                title: "Sensitivity";
                status: root.dpi-status;
                status-is-error: root.dpi-status-is-error;

                HorizontalLayout {
                    alignment: start;
                    spacing: 8px;
                    if root.separate-xy: Text {
                        text: "X";
                        color: Theme.text-muted;
                        font-size: Theme.font-body;
                        vertical-alignment: center;
                    }
                    NumberField {
                        label: root.separate-xy ? "Horizontal DPI" : "DPI";
                        value: root.dpi-x;
                        minimum: 100;
                        maximum: 6400;
                        step: 50;
                        committed(v) => {
                            root.dpi-x = v;
                            if (!root.separate-xy) {
                                root.dpi-y = v;
                            }
                            root.apply-dpi(root.dpi-x, root.dpi-y);
                        }
                    }
                    if root.separate-xy: Rectangle { width: 6px; }
                    if root.separate-xy: Text {
                        text: "Y";
                        color: Theme.text-muted;
                        font-size: Theme.font-body;
                        vertical-alignment: center;
                    }
                    if root.separate-xy: NumberField {
                        label: "Vertical DPI";
                        value: root.dpi-y;
                        minimum: 100;
                        maximum: 6400;
                        step: 50;
                        committed(v) => {
                            root.dpi-y = v;
                            root.apply-dpi(root.dpi-x, root.dpi-y);
                        }
                    }
                    Text {
                        text: "DPI";
                        color: Theme.text-muted;
                        font-size: Theme.font-body;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 14px;
                    if root.separate-xy: Text {
                        text: "X";
                        color: Theme.text-muted;
                        font-size: Theme.font-body;
                        vertical-alignment: center;
                        min-width: 14px;
                    }
                    TuneSlider {
                        label: root.separate-xy ? "Horizontal DPI" : "DPI";
                        minimum: 100;
                        maximum: 6400;
                        step: 50;
                        logarithmic: true;
                        value: root.dpi-x;
                        epoch: root.epoch;
                        changed(v) => {
                            root.dpi-x = v;
                            if (!root.separate-xy) {
                                root.dpi-y = v;
                            }
                        }
                        released => {
                            root.apply-dpi(root.dpi-x, root.dpi-y);
                        }
                    }
                }
                if root.separate-xy: HorizontalLayout {
                    spacing: 14px;
                    Text {
                        text: "Y";
                        color: Theme.text-muted;
                        font-size: Theme.font-body;
                        vertical-alignment: center;
                        min-width: 14px;
                    }
                    TuneSlider {
                        label: "Vertical DPI";
                        minimum: 100;
                        maximum: 6400;
                        step: 50;
                        logarithmic: true;
                        value: root.dpi-y;
                        epoch: root.epoch;
                        changed(v) => {
                            root.dpi-y = v;
                        }
                        released => {
                            root.apply-dpi(root.dpi-x, root.dpi-y);
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    for preset in root.presets: Chip {
                        text: preset;
                        active: root.dpi-x == preset && root.dpi-y == preset;
                        clicked => {
                            root.dpi-x = preset;
                            root.dpi-y = preset;
                            root.apply-dpi(preset, preset);
                        }
                    }
                }

                Toggle {
                    text: "Separate X and Y";
                    checked <=> root.separate-xy;
                    toggled(on) => {
                        if (!on && root.dpi-y != root.dpi-x) {
                            root.dpi-y = root.dpi-x;
                            root.apply-dpi(root.dpi-x, root.dpi-x);
                        }
                    }
                }
            }
            Divider { }

            Section {
                title: "Polling rate";
                status: root.polling-status;
                status-is-error: root.polling-status-is-error;

                Segmented {
                    label: "Polling rate";
                    options: ["125 Hz", "500 Hz", "1000 Hz"];
                    current: root.polling-index;
                    selected(index) => {
                        root.apply-polling(index);
                    }
                }
            }

            for led[index] in root.leds: VerticalLayout {
                Divider { }
                Section {
                    title: led.name;
                    status: led.status;
                    status-is-error: led.status-is-error;

                    Segmented {
                        label: led.name + " effect";
                        options: ["Off", "Static", "Breathe"];
                        current: led.effect;
                        selected(effect) => {
                            root.apply-effect(led.id, effect);
                        }
                    }
                    if led.effect == -1: Text {
                        text: "The mouse can't report its current effect. Pick one to set it.";
                        color: Theme.text-muted;
                        font-size: Theme.font-small;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 14px;
                        Text {
                            text: "Brightness";
                            color: Theme.text-muted;
                            font-size: Theme.font-body;
                            vertical-alignment: center;
                            min-width: 76px;
                        }
                        brightness := TuneSlider {
                            label: led.name + " brightness";
                            minimum: 0;
                            maximum: 100;
                            step: 1;
                            value: led.brightness;
                            epoch: root.epoch;
                            released(v) => {
                                root.apply-brightness(led.id, Math.round(v));
                            }
                        }
                        Text {
                            text: Math.round(brightness.shown) + "%";
                            color: Theme.text;
                            font-size: Theme.font-body;
                            min-width: 40px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
    }
}
