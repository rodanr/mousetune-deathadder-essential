import "fonts/Oxanium-Medium.ttf";
import "fonts/Oxanium-SemiBold.ttf";
import "fonts/Oxanium-Bold.ttf";
import { Theme } from "theme.slint";
import { HudPanel } from "components/hud-panel.slint";
import { DpiDial } from "components/dpi-dial.slint";
import { TuneSlider } from "components/tune-slider.slint";
import { Segmented } from "components/segmented.slint";
import { Chip } from "components/chip.slint";
import { Toggle } from "components/toggle.slint";
import { Banner } from "components/banner.slint";
import { NumberField } from "components/number-field.slint";
import { StatusLine } from "components/status-line.slint";
import { AboutOverlay } from "components/about.slint";

export { Theme }

/// Which screen the window shows.
export enum Screen { searching, unsupported, permission, busy, error, connected }

/// One LED. `effect` is -1 while unknown; `brightness` is a percentage.
export struct LedData {
    id: int,
    name: string,
    effect: int,
    brightness: int,
    status: string,
    status-is-error: bool,
}

export component MainWindow inherits Window {
    title: "MouseTune for DeathAdder Essential";
    icon: @image-url("../../assets/icon-256.png");
    background: Theme.window;
    // Fixed size: the layout is designed for exactly this canvas (the window
    // is also made non-resizable, see ui::run).
    width: 800px;
    height: 592px;

    in property <Screen> screen: Screen.searching;
    in property <string> message;
    in property <string> model-name;
    in property <string> firmware;
    in property <string> serial;
    in property <string> version;
    in-out property <float> dpi-x: 800;
    in-out property <float> dpi-y: 800;
    in-out property <bool> separate-xy: false;
    in property <string> dpi-status;
    in property <bool> dpi-status-is-error;
    in property <int> polling-index: -1;
    in property <string> polling-status;
    in property <bool> polling-status-is-error;
    in property <[LedData]> leds;
    /// Bumped by the app on every worker event; sliders drop local edits.
    in property <int> epoch;

    callback apply-dpi(int, int);
    callback apply-polling(int);
    callback apply-effect(int, int);
    callback apply-brightness(int, int);
    callback open-settings();
    callback request-access();
    callback open-project();
    /// Whether the About panel is showing.
    in-out property <bool> about-open: false;

    private property <[float]> presets: [400, 800, 1600, 3200, 6400];
    /// Axis the dial edits in separate X/Y mode: 0 = X, 1 = Y.
    private property <int> axis: 0;
    private property <float> dial-value: root.separate-xy && root.axis == 1 ? root.dpi-y : root.dpi-x;

    function set-dial(v: float) {
        if (!root.separate-xy) {
            root.dpi-x = v;
            root.dpi-y = v;
        } else if (root.axis == 0) {
            root.dpi-x = v;
        } else {
            root.dpi-y = v;
        }
    }

    VerticalLayout {
        width: root.width;
        height: root.height;

    // Screen area
    Rectangle {
        vertical-stretch: 1;

    if root.screen == Screen.searching: Banner {
        icon: @image-url("icons/mouse.svg");
        pulse: true;
        title: "Connect your DeathAdder Essential";
        body: "Plug in the mouse. MouseTune finds it automatically.";
    }
    if root.screen == Screen.unsupported: Banner {
        icon: @image-url("icons/mouse-off.svg");
        attention: true;
        title: "This mouse isn't supported";
        body: "MouseTune works with the DeathAdder Essential only.";
    }
    if root.screen == Screen.permission: Banner {
        icon: @image-url("icons/lock.svg");
        title: "Allow Input Monitoring";
        body: "macOS needs your permission before MouseTune can talk to the mouse. In System Settings, open Privacy & Security → Input Monitoring, switch MouseTune on, then reopen the app.";
        action: "Open System Settings";
        activated => {
            root.request-access();
            root.open-settings();
        }
    }
    if root.screen == Screen.busy: Banner {
        icon: @image-url("icons/alert.svg");
        attention: true;
        title: "Another app is using the mouse";
        body: "Quit Razer Synapse or any other mouse utility, then unplug the mouse and plug it back in.";
    }
    if root.screen == Screen.error: Banner {
        icon: @image-url("icons/alert.svg");
        attention: true;
        title: "Couldn't talk to the mouse";
        body: root.message + "\nUnplug the mouse and plug it back in. MouseTune will retry.";
    }

    if root.screen == Screen.connected: VerticalLayout {
        // Pinned to the screen area: content sizes never resize the layout.
        width: parent.width;
        height: parent.height;
        padding: Theme.page-pad;
        padding-bottom: 0;
        spacing: Theme.gap;

        // Header
        HorizontalLayout {
            spacing: 12px;
            Image {
                source: @image-url("../../assets/logo/mousetune-symbol-black.svg");
                colorize: Theme.accent;
                width: 34px;
                height: 34px;
                y: (parent.height - self.height) / 2;
                accessible-role: none;
            }
            VerticalLayout {
                spacing: 1px;
                Text {
                    text: root.model-name;
                    color: Theme.text;
                    font-family: Theme.display;
                    font-size: Theme.font-title;
                    font-weight: 700;
                    accessible-role: text;
                }
                Text {
                    text: root.serial == "" ? "Firmware " + root.firmware : "Firmware " + root.firmware + "  ·  Serial " + root.serial;
                    color: Theme.text-muted;
                    font-size: Theme.font-small;
                }
            }
            Rectangle { horizontal-stretch: 1; }
            // Status pill
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: pill.preferred-width + 24px;
                    height: 26px;
                    border-radius: Theme.radius;
                    background: #3ee6a014;
                    border-width: 1px;
                    border-color: #3ee6a055;
                    pill := HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 7px;
                        alignment: center;
                        Rectangle {
                            width: 7px;
                            Rectangle {
                                width: 7px;
                                height: 7px;
                                border-radius: 3.5px;
                                background: Theme.success;
                                drop-shadow-blur: 6px;
                                drop-shadow-color: Theme.success;
                            }
                        }
                        Text {
                            text: "CONNECTED";
                            color: Theme.success;
                            font-family: Theme.display;
                            font-size: 11px;
                            font-weight: 600;
                            letter-spacing: Theme.label-tracking;
                            vertical-alignment: center;
                            accessible-role: text;
                        }
                    }
                }
            }
        }

        // The columns take all spare height, so the footer always sits on
        // the bottom edge whatever the model.
        HorizontalLayout {
            spacing: Theme.gap;
            vertical-stretch: 1;

            // Sensitivity: the hero
            HudPanel {
                width: 368px;
                title: "SENSITIVITY";
                status: root.dpi-status;
                status-is-error: root.dpi-status-is-error;

                // Flexible space above and below keeps the gauge centred and
                // lets the panel grow to the full column height.
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    alignment: center;
                    DpiDial {
                        label: root.separate-xy ? (root.axis == 0 ? "Horizontal DPI" : "Vertical DPI") : "DPI";
                        value: root.dial-value;
                        epoch: root.epoch;
                        changed(v) => {
                            root.set-dial(v);
                        }
                        released => {
                            root.apply-dpi(root.dpi-x, root.dpi-y);
                        }

                        HorizontalLayout {
                            alignment: center;
                            NumberField {
                                label: root.separate-xy ? (root.axis == 0 ? "Horizontal DPI" : "Vertical DPI") : "DPI";
                                value: root.dial-value;
                                minimum: 100;
                                maximum: 6400;
                                step: 50;
                                committed(v) => {
                                    root.set-dial(v);
                                    root.apply-dpi(root.dpi-x, root.dpi-y);
                                }
                            }
                        }
                        Text {
                            text: root.separate-xy ? (root.axis == 0 ? "X  ·  DPI" : "Y  ·  DPI") : "DPI";
                            color: Theme.text-muted;
                            font-family: Theme.display;
                            font-size: Theme.font-label;
                            font-weight: 600;
                            letter-spacing: Theme.label-tracking;
                            horizontal-alignment: center;
                        }
                        if root.separate-xy: Text {
                            text: root.axis == 0 ? "Y " + Math.round(root.dpi-y) : "X " + Math.round(root.dpi-x);
                            color: Theme.text-muted;
                            font-family: Theme.display;
                            font-size: Theme.font-small;
                            horizontal-alignment: center;
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }

                if root.separate-xy: HorizontalLayout {
                    alignment: center;
                    Segmented {
                        width: 160px;
                        height: 30px;
                        label: "Axis the dial edits";
                        options: ["X axis", "Y axis"];
                        current: root.axis;
                        selected(index) => {
                            root.axis = index;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    for preset in root.presets: Chip {
                        text: preset;
                        active: root.dpi-x == preset && root.dpi-y == preset;
                        clicked => {
                            root.dpi-x = preset;
                            root.dpi-y = preset;
                            root.apply-dpi(preset, preset);
                        }
                    }
                }

                Toggle {
                    text: "Separate X and Y";
                    checked <=> root.separate-xy;
                    toggled(on) => {
                        if (!on) {
                            root.axis = 0;
                            if (root.dpi-y != root.dpi-x) {
                                root.dpi-y = root.dpi-x;
                                root.apply-dpi(root.dpi-x, root.dpi-x);
                            }
                        }
                    }
                }
            }

            VerticalLayout {
                spacing: Theme.gap;

                HudPanel {
                    title: "POLLING RATE";
                    status: root.polling-status;
                    status-is-error: root.polling-status-is-error;

                    Segmented {
                        label: "Polling rate";
                        options: ["125 Hz", "500 Hz", "1000 Hz"];
                        current: root.polling-index;
                        selected(index) => {
                            root.apply-polling(index);
                        }
                    }
                }

                // Stretches so both columns end on the same line.
                HudPanel {
                    title: "LIGHTING";
                    vertical-stretch: 1;

                    VerticalLayout {
                    alignment: start;
                    spacing: Theme.gap;

                    for led in root.leds: VerticalLayout {
                        spacing: 8px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: led.name;
                                color: Theme.text;
                                font-family: Theme.display;
                                font-size: Theme.font-body;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                            StatusLine {
                                text: led.status;
                                is-error: led.status-is-error;
                            }
                        }
                        Segmented {
                            label: led.name + " effect";
                            options: ["Off", "Static", "Breathe"];
                            current: led.effect;
                            selected(effect) => {
                                root.apply-effect(led.id, effect);
                            }
                        }
                        if led.effect == -1: Text {
                            text: "The mouse can't report its current effect. Pick one to set it.";
                            color: Theme.text-muted;
                            font-size: Theme.font-small;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: "Brightness";
                                color: Theme.text-muted;
                                font-size: Theme.font-small + 1px;
                                vertical-alignment: center;
                                min-width: 68px;
                            }
                            brightness := TuneSlider {
                                label: led.name + " brightness";
                                minimum: 0;
                                maximum: 100;
                                step: 1;
                                value: led.brightness;
                                epoch: root.epoch;
                                released(v) => {
                                    root.apply-brightness(led.id, Math.round(v));
                                }
                            }
                            Text {
                                text: Math.round(brightness.shown) + "%";
                                color: Theme.text;
                                font-family: Theme.display;
                                font-size: Theme.font-body;
                                font-weight: 600;
                                min-width: 40px;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                    }
                }
            }
    }
    }

    // Footer bar, on every screen
    HorizontalLayout {
        padding: Theme.page-pad;
        padding-top: Theme.gap;
        spacing: 8px;

        if root.screen == Screen.connected: Rectangle {
            width: 6px;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 1px;
                background: Theme.accent;
            }
        }
        if root.screen == Screen.connected: Text {
            text: "Changes are written to the mouse as you make them.";
            color: Theme.text-muted;
            font-size: Theme.font-small;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; }
        Text {
            text: "Not affiliated with Razer Inc.";
            color: Theme.text-muted;
            font-size: Theme.font-small;
            vertical-alignment: center;
        }
        Text {
            text: "·";
            color: Theme.text-muted;
            vertical-alignment: center;
        }
        about-link := Rectangle {
            width: about-text.preferred-width;
            accessible-role: button;
            accessible-label: "About MouseTune";
            accessible-action-default => { root.about-open = true; }
            about-text := Text {
                text: "ABOUT  " + root.version;
                color: about-touch.has-hover || about-scope.has-focus ? Theme.accent-hi : Theme.text-muted;
                font-family: Theme.display;
                font-size: 11px;
                font-weight: 600;
                letter-spacing: Theme.label-tracking;
                vertical-alignment: center;
            }
            about-scope := FocusScope {
                key-pressed(event) => {
                    if (event.text == " " || event.text == "\n") {
                        root.about-open = true;
                        return accept;
                    }
                    return reject;
                }
            }
            about-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.about-open = true;
                }
            }
        }
    }
    }

    if root.about-open: AboutOverlay {
        width: root.width;
        height: root.height;
        version: root.version;
        close => {
            root.about-open = false;
        }
        open-project => {
            root.open-project();
        }
    }
}
