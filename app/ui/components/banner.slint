import { Theme } from "../theme.slint";

/// Full-window message for the states where no settings can be shown, with
/// one optional primary action.
export component Banner inherits VerticalLayout {
    in property <image> icon;
    in property <string> title;
    in property <string> body;
    in property <string> action;
    in property <bool> attention;
    /// Slowly pulse the icon (used while searching for the mouse).
    in property <bool> pulse;
    callback activated();

    private property <bool> dim;
    Timer {
        interval: 1100ms;
        running: root.pulse;
        triggered => {
            root.dim = !root.dim;
        }
    }

    alignment: center;
    spacing: 10px;
    padding: 56px;

    HorizontalLayout {
        alignment: center;
        Image {
            source: root.icon;
            colorize: root.attention ? Theme.danger : Theme.accent;
            width: 44px;
            height: 44px;
            opacity: root.pulse && root.dim ? 0.45 : 1;
            animate opacity { duration: 1100ms; easing: ease-in-out; }
            accessible-role: none;
        }
    }
    Rectangle { height: 6px; }
    Text {
        text: root.title;
        color: Theme.text;
        font-family: Theme.display;
        font-size: Theme.font-title + 3px;
        font-weight: 700;
        horizontal-alignment: center;
        wrap: word-wrap;
        accessible-role: text;
    }
    // Keep prose at a readable measure on the wide window.
    HorizontalLayout {
        alignment: center;
        Text {
            max-width: 440px;
            text: root.body;
            color: Theme.text-muted;
            font-size: Theme.font-body;
            horizontal-alignment: center;
            wrap: word-wrap;
            accessible-role: text;
        }
    }
    if root.action != "": HorizontalLayout {
        alignment: center;
        padding-top: 10px;
        Rectangle {
            width: label.preferred-width + 36px;
            height: Theme.control-height;
            border-radius: Theme.radius;
            background: touch.has-hover
                ? @linear-gradient(90deg, Theme.accent-hi 0%, Theme.focus 100%)
                : @linear-gradient(90deg, Theme.accent 0%, Theme.accent-hi 100%);
            drop-shadow-blur: 16px;
            drop-shadow-color: Theme.accent-glow;
            border-width: scope.has-focus ? 2px : 0px;
            border-color: Theme.text;
            accessible-role: button;
            accessible-label: root.action;
            accessible-action-default => { root.activated(); }
            label := Text {
                text: root.action;
                color: Theme.on-accent;
                font-family: Theme.display;
                font-size: Theme.font-body;
                font-weight: 700;
                letter-spacing: 0.6px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            scope := FocusScope {
                key-pressed(event) => {
                    if (event.text == " " || event.text == "\n") {
                        root.activated();
                        return accept;
                    }
                    return reject;
                }
            }
            touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    scope.focus();
                    root.activated();
                }
            }
        }
    }
}
