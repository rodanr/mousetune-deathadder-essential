import { Theme } from "../theme.slint";

/// Full-window message for the states where no settings can be shown, with
/// one optional primary action.
export component Banner inherits VerticalLayout {
    in property <image> icon;
    in property <string> title;
    in property <string> body;
    in property <string> action;
    in property <bool> attention;
    callback activated();

    alignment: center;
    spacing: 10px;
    padding: 40px;

    HorizontalLayout {
        alignment: center;
        Image {
            source: root.icon;
            colorize: root.attention ? Theme.danger : Theme.text-muted;
            width: 44px;
            height: 44px;
            accessible-role: none;
        }
    }
    Rectangle { height: 6px; }
    Text {
        text: root.title;
        color: Theme.text;
        font-size: Theme.font-title;
        font-weight: 600;
        horizontal-alignment: center;
        wrap: word-wrap;
        accessible-role: text;
    }
    Text {
        text: root.body;
        color: Theme.text-muted;
        font-size: Theme.font-body;
        horizontal-alignment: center;
        wrap: word-wrap;
        accessible-role: text;
    }
    if root.action != "": HorizontalLayout {
        alignment: center;
        padding-top: 10px;
        Rectangle {
            width: label.preferred-width + 36px;
            height: Theme.control-height;
            border-radius: Theme.radius;
            background: touch.has-hover ? Theme.focus : Theme.accent;
            border-width: scope.has-focus ? 2px : 0px;
            border-color: Theme.text;
            accessible-role: button;
            accessible-label: root.action;
            accessible-action-default => { root.activated(); }
            label := Text {
                text: root.action;
                color: Theme.on-accent;
                font-size: Theme.font-body;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            scope := FocusScope {
                key-pressed(event) => {
                    if (event.text == " " || event.text == "\n") {
                        root.activated();
                        return accept;
                    }
                    return reject;
                }
            }
            touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    scope.focus();
                    root.activated();
                }
            }
        }
    }
}
