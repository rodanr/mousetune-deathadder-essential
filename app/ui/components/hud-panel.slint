import { Theme } from "../theme.slint";
import { StatusLine } from "status-line.slint";

/// A HUD panel (two cut corners) with an accent-marked title and an optional
/// status on the right.
export component HudPanel inherits Rectangle {
    in property <string> title;
    in property <string> status;
    in property <bool> status-is-error;

    // Tech silhouette: two cut corners, two tight ones.
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.panel-edge;
    border-top-left-radius: Theme.chamfer;
    border-bottom-right-radius: Theme.chamfer;
    border-top-right-radius: Theme.radius;
    border-bottom-left-radius: Theme.radius;

    VerticalLayout {
        padding: Theme.panel-pad;
        spacing: Theme.gap;

        HorizontalLayout {
            spacing: 8px;
            // Accent marker, aligned with the title.
            Rectangle {
                width: 3px;
                Rectangle {
                    width: 3px;
                    height: 12px;
                    border-radius: 1px;
                    background: Theme.accent;
                }
            }
            Text {
                text: root.title;
                color: Theme.text-muted;
                font-family: Theme.display;
                font-size: Theme.font-label;
                font-weight: 600;
                letter-spacing: Theme.label-tracking;
                vertical-alignment: center;
                accessible-role: text;
            }
            StatusLine {
                text: root.status;
                is-error: root.status-is-error;
            }
        }

        @children
    }
}
