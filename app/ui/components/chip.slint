import { Theme } from "../theme.slint";

/// A compact preset button.
export component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();

    height: 30px;
    horizontal-stretch: 1;
    border-radius: Theme.radius;
    background: root.active ? Theme.accent : (touch.has-hover ? Theme.control-hover : Theme.control);
    border-width: scope.has-focus ? 2px : 0px;
    border-color: Theme.focus;
    accessible-role: button;
    accessible-label: root.text + " DPI";
    accessible-action-default => { root.clicked(); }
    animate background { duration: 150ms; easing: ease-out; }

    Text {
        text: root.text;
        color: root.active ? Theme.on-accent : Theme.text;
        font-size: Theme.font-small;
        font-weight: root.active ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    scope := FocusScope {
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            scope.focus();
            root.clicked();
        }
    }
}
