// SPDX-License-Identifier: GPL-3.0-or-later
import { Theme } from "../theme.slint";

/// The DPI gauge: a 270° dial on a logarithmic scale, mirroring the app icon.
///
/// Like TuneSlider, `value` always comes from the parent; while the user drags
/// (until the next `epoch` bump) the dial shows its own local value.
/// `changed` fires while dragging, `released` once when the user lets go or
/// after a keyboard step. Children are centred inside the dial.
export component DpiDial inherits Rectangle {
    in property <float> value;
    in property <int> epoch;
    in property <string> label: "DPI";
    in property <float> minimum: 100;
    in property <float> maximum: 6400;
    in property <float> step: 50;
    out property <float> shown: root.editing ? root.local : root.value;
    callback changed(float);
    callback released(float);

    private property <bool> editing;
    private property <float> local;
    private property <float> size: 252;
    private property <float> mid: root.size / 2;
    private property <float> radius: 100;
    private property <float> fraction: root.to-fraction(root.shown);
    /// Draw at least a sliver so the arc never degenerates at the minimum.
    private property <float> drawn: Math.max(root.fraction, 0.004);
    private property <float> end-angle: 135 + 270 * root.drawn;

    width: root.size * 1px;
    height: root.size * 1px;
    forward-focus: focus;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: root.shown;
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: root.step;
    accessible-action-increment => { root.nudge(1); }
    accessible-action-decrement => { root.nudge(-1); }

    changed epoch => {
        root.editing = false;
    }

    pure function to-fraction(v: float) -> float {
        return Math.clamp(Math.ln(Math.max(v, root.minimum) / root.minimum) / Math.ln(root.maximum / root.minimum), 0, 1);
    }
    pure function from-fraction(t: float) -> float {
        return root.minimum * Math.exp(Math.clamp(t, 0, 1) * Math.ln(root.maximum / root.minimum));
    }
    pure function px(degrees: float, r: float) -> float {
        return root.mid + r * Math.cos(degrees * 1deg);
    }
    pure function py(degrees: float, r: float) -> float {
        return root.mid + r * Math.sin(degrees * 1deg);
    }
    function snap(raw: float) -> float {
        return Math.clamp(Math.round(raw / root.step) * root.step, root.minimum, root.maximum);
    }
    function edit(raw: float) {
        root.local = root.snap(raw);
        root.editing = true;
        root.changed(root.local);
    }
    function nudge(direction: float) {
        root.edit(root.shown + direction * root.step);
        root.released(root.local);
    }

    // A segmented LED-style gauge: 48 segments along the 270deg arc light up
    // to the current value. Built from plain circles so every renderer
    // (including the software one used for snapshots) draws it identically.
    private property <int> segments: 48;

    // Core glow
    Rectangle {
        width: 300px;
        height: 300px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: @radial-gradient(circle, #3b8cff30 0%, #3b8cff12 36%, transparent 68%);
    }

    for i in root.segments: Rectangle {
        property <float> t: i / (root.segments - 1);
        property <float> angle: 135 + 270 * self.t;
        property <bool> lit: self.t <= root.fraction + 0.0001;
        width: 7px;
        height: 7px;
        x: root.px(self.angle, root.radius) * 1px - self.width / 2;
        y: root.py(self.angle, root.radius) * 1px - self.height / 2;
        border-radius: 3.5px;
        background: self.lit ? (self.t > root.fraction - 0.12 ? Theme.accent-hi : Theme.accent) : Theme.control-edge;
        drop-shadow-blur: self.lit ? 6px : 0px;
        drop-shadow-color: Theme.accent-glow;
    }

    // Scale marks outside the gauge every 45deg.
    for i in 7: Rectangle {
        property <float> angle: 135 + i * 45;
        width: 3px;
        height: 3px;
        x: root.px(self.angle, root.radius + 16) * 1px - self.width / 2;
        y: root.py(self.angle, root.radius + 16) * 1px - self.height / 2;
        border-radius: 1.5px;
        background: Theme.text-muted;
        opacity: 0.6;
    }

    // Focus ring around the knob
    Rectangle {
        visible: focus.has-focus;
        width: 34px;
        height: 34px;
        x: root.px(root.end-angle, root.radius) * 1px - self.width / 2;
        y: root.py(root.end-angle, root.radius) * 1px - self.height / 2;
        border-radius: self.width / 2;
        border-width: 2px;
        border-color: Theme.focus;
    }
    // Knob
    Rectangle {
        width: touch.pressed ? 24px : 20px;
        height: self.width;
        x: root.px(root.end-angle, root.radius) * 1px - self.width / 2;
        y: root.py(root.end-angle, root.radius) * 1px - self.height / 2;
        border-radius: self.width / 2;
        background: #ffffff;
        border-width: 4px;
        border-color: Theme.accent;
        drop-shadow-blur: 14px;
        drop-shadow-color: Theme.accent-glow;
        animate width { duration: 120ms; easing: ease-out; }
    }

    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.LeftArrow || event.text == Key.DownArrow) {
                root.nudge(-1);
                return accept;
            }
            if (event.text == Key.RightArrow || event.text == Key.UpArrow) {
                root.nudge(1);
                return accept;
            }
            return reject;
        }
    }

    // Drag anywhere on the ring; the centre belongs to the children.
    touch := TouchArea {
        mouse-cursor: pointer;
        function pointer-value() -> float {
            let degrees = Math.atan2(self.mouse-y / 1px - root.mid, self.mouse-x / 1px - root.mid) / 1deg;
            let along = Math.mod(degrees - 135 + 720, 360);
            // In the gap at the bottom: snap to whichever end is nearer.
            let clamped = along > 270 ? (along > 315 ? 0 : 270) : along;
            return root.from-fraction(clamped / 270);
        }
        pointer-event(event) => {
            if (event.button == PointerEventButton.left) {
                if (event.kind == PointerEventKind.down) {
                    focus.focus();
                    root.edit(self.pointer-value());
                } else if (event.kind == PointerEventKind.up && root.editing) {
                    root.released(root.local);
                }
            }
        }
        moved => {
            if (self.pressed) {
                root.edit(self.pointer-value());
            }
        }
    }

    VerticalLayout {
        alignment: center;
        @children
    }
}
