import { Theme } from "../theme.slint";

/// A settings group: heading, optional status on the right, then content.
/// Groups are separated by hairlines rather than boxed in cards.
export component Section inherits VerticalLayout {
    in property <string> title;
    in property <string> status;
    in property <bool> status-is-error;
    in property <bool> first: false;

    spacing: Theme.gap;
    padding-top: root.first ? 0 : Theme.section-pad;
    padding-bottom: Theme.section-pad;

    HorizontalLayout {
        spacing: 8px;
        Text {
            text: root.title;
            color: Theme.text;
            font-size: Theme.font-heading;
            font-weight: 600;
            vertical-alignment: center;
            accessible-role: text;
        }
        Rectangle { horizontal-stretch: 1; }
        if root.status != "" && !root.status-is-error: Image {
            source: @image-url("../icons/check.svg");
            colorize: Theme.success;
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;
            accessible-role: none;
        }
        Text {
            horizontal-stretch: 0;
            max-width: 280px;
            text: root.status;
            color: root.status-is-error ? Theme.danger : Theme.success;
            font-size: Theme.font-small;
            horizontal-alignment: right;
            vertical-alignment: center;
            wrap: word-wrap;
            accessible-role: text;
            opacity: root.status == "" ? 0 : 1;
            animate opacity { duration: 180ms; easing: ease-out; }
        }
    }

    @children
}

/// A 1px horizontal rule between sections.
export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.divider;
}
