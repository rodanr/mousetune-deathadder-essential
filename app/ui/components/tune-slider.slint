import { Theme } from "../theme.slint";

/// Horizontal slider, optionally logarithmic.
///
/// `value` always comes from the parent and is never overwritten here, so it
/// keeps following the device. While the user drags (and until the next
/// `epoch` bump confirms or rejects the change) the slider shows its own
/// local value. `changed` fires while dragging, `released` once when the
/// user lets go or after a keyboard step: that is when to apply.
export component TuneSlider inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 1;
    in property <float> value;
    in property <int> epoch;
    in property <string> label;
    /// Equal travel per doubling: gives low values (where most DPI settings
    /// live) as much room as high ones.
    in property <bool> logarithmic;
    out property <float> shown: root.editing ? root.local : root.value;
    callback changed(float);
    callback released(float);

    private property <bool> editing;
    private property <float> local;
    private property <length> handle-size: 18px;
    private property <float> fraction: root.to-fraction(root.shown);

    changed epoch => {
        root.editing = false;
    }

    height: 28px;
    forward-focus: focus;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: root.shown;
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: root.step;
    accessible-action-increment => { root.nudge(1); }
    accessible-action-decrement => { root.nudge(-1); }

    pure function to-fraction(v: float) -> float {
        if (root.logarithmic) {
            return Math.ln(Math.max(v, root.minimum) / root.minimum) / Math.ln(root.maximum / root.minimum);
        }
        return (v - root.minimum) / (root.maximum - root.minimum);
    }

    pure function from-fraction(t: float) -> float {
        let clamped = Math.clamp(t, 0, 1);
        if (root.logarithmic) {
            return root.minimum * Math.exp(clamped * Math.ln(root.maximum / root.minimum));
        }
        return root.minimum + clamped * (root.maximum - root.minimum);
    }

    function snap(raw: float) -> float {
        return Math.clamp(Math.round(raw / root.step) * root.step, root.minimum, root.maximum);
    }

    function edit(raw: float) {
        root.local = root.snap(raw);
        root.editing = true;
        root.changed(root.local);
    }

    function nudge(direction: float) {
        root.edit(root.shown + direction * root.step);
        root.released(root.local);
    }

    private property <length> track-y: 14px;

    // Track
    Rectangle {
        y: root.track-y - self.height / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.control;
    }
    // Filled part
    Rectangle {
        x: 0;
        y: root.track-y - self.height / 2;
        height: 4px;
        width: root.fraction * (parent.width - root.handle-size) + root.handle-size / 2;
        border-radius: 2px;
        background: Theme.accent;
    }
    // Focus ring
    Rectangle {
        visible: focus.has-focus;
        x: root.fraction * (parent.width - root.handle-size) - 4px;
        y: root.track-y - self.height / 2;
        width: root.handle-size + 8px;
        height: root.handle-size + 8px;
        border-radius: self.height / 2;
        border-width: 2px;
        border-color: Theme.focus;
    }
    // Handle
    Rectangle {
        x: root.fraction * (parent.width - root.handle-size);
        y: root.track-y - self.height / 2;
        width: root.handle-size;
        height: root.handle-size;
        border-radius: root.handle-size / 2;
        background: #ffffff;
        border-width: touch.has-hover || touch.pressed ? 5px : 4px;
        border-color: Theme.accent;
        drop-shadow-offset-y: 1px;
        drop-shadow-blur: 3px;
        drop-shadow-color: #00000040;
    }

    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.LeftArrow || event.text == Key.DownArrow) {
                root.nudge(-1);
                return accept;
            }
            if (event.text == Key.RightArrow || event.text == Key.UpArrow) {
                root.nudge(1);
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        function pointer-value() -> float {
            let usable = self.width - root.handle-size;
            return root.from-fraction((self.mouse-x - root.handle-size / 2) / usable);
        }
        pointer-event(event) => {
            if (event.button == PointerEventButton.left) {
                if (event.kind == PointerEventKind.down) {
                    focus.focus();
                    root.edit(self.pointer-value());
                } else if (event.kind == PointerEventKind.up && root.editing) {
                    root.released(root.local);
                }
            }
        }
        moved => {
            if (self.pressed) {
                root.edit(self.pointer-value());
            }
        }
    }
}
