// SPDX-License-Identifier: GPL-3.0-or-later
import { Theme } from "../theme.slint";

/// A row of mutually exclusive options. `current` is -1 when none is known.
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in property <int> current: -1;
    in property <string> label;
    callback selected(int);

    height: Theme.control-height;
    background: Theme.control;
    border-radius: Theme.radius;
    accessible-role: tab-list;
    accessible-label: root.label;

    HorizontalLayout {
        padding: 3px;
        spacing: 3px;
        for option[index] in root.options: Rectangle {
            property <bool> active: index == root.current;
            border-radius: Theme.radius - 2px;
            background: self.active ? Theme.accent : (touch.has-hover ? Theme.control-hover : transparent);
            border-width: scope.has-focus ? 2px : 0px;
            border-color: Theme.focus;
            accessible-role: tab;
            accessible-label: option;
            accessible-checkable: true;
            accessible-checked: self.active;
            accessible-action-default => { root.selected(index); }
            animate background { duration: 150ms; easing: ease-out; }

            Text {
                text: option;
                color: parent.active ? Theme.on-accent : Theme.text;
                font-size: Theme.font-body;
                font-weight: parent.active ? 600 : 400;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            scope := FocusScope {
                key-pressed(event) => {
                    if (event.text == " " || event.text == "\n") {
                        root.selected(index);
                        return accept;
                    }
                    if (event.text == Key.RightArrow && index + 1 < root.options.length) {
                        root.selected(index + 1);
                        return accept;
                    }
                    if (event.text == Key.LeftArrow && index > 0) {
                        root.selected(index - 1);
                        return accept;
                    }
                    return reject;
                }
            }
            touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    scope.focus();
                    root.selected(index);
                }
            }
        }
    }
}
