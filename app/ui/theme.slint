// Design tokens. Every colour, size and radius used by the UI comes from here.
import { Palette } from "std-widgets.slint";

export global Theme {
    out property <bool> dark: Palette.color-scheme != ColorScheme.light;

    // Surfaces
    out property <color> window: dark ? #0f1216 : #f3f4f7;
    out property <color> surface: dark ? #171b21 : #ffffff;
    out property <color> surface-raised: dark ? #1f242c : #eceef3;
    out property <color> border: dark ? #2b313b : #d6dae1;

    // Text
    out property <color> text: dark ? #eceff4 : #131820;
    out property <color> text-muted: dark ? #9aa4b2 : #566070;

    // Accent and status
    out property <color> accent: dark ? #5b9bff : #2563d9;
    out property <color> on-accent: dark ? #08111f : #ffffff;
    out property <color> danger: dark ? #ff7a7a : #c62828;
    out property <color> success: dark ? #4cd9a0 : #0f8a5f;

    // Geometry
    out property <length> radius-card: 14px;
    out property <length> radius-control: 8px;
    out property <length> gap: 12px;
    out property <length> pad: 18px;
    out property <length> control-height: 36px;

    // Type
    out property <length> font-title: 20px;
    out property <length> font-body: 14px;
    out property <length> font-small: 12px;
    out property <length> font-display: 30px;
}
