// Design tokens for MouseTune's HUD look. Every colour, size and radius used
// by the UI comes from here. Dark only: it's a gaming tool used in dim setups.

export global Theme {
    // Surfaces, deepest first.
    out property <color> window: #07090d;
    out property <color> panel: #0d1117;
    out property <color> panel-edge: #1d2530;
    out property <color> control: #131921;
    out property <color> control-hover: #1a222d;
    out property <color> control-edge: #232c38;

    // Text
    out property <color> text: #e8edf5;
    out property <color> text-muted: #8a96a8;
    // Decorative marks only (ticks), never text.
    out property <color> mark: #2a3442;

    // Electric blue: current value, selection and focus. Never Razer green.
    out property <color> accent: #3b8cff;
    out property <color> accent-hi: #7cc4ff;
    out property <color> accent-glow: #3b8cff66;
    out property <color> on-accent: #03101f;
    out property <color> focus: #9fd0ff;
    out property <color> danger: #ff5f7e;
    out property <color> success: #3ee6a0;

    // Geometry: small radii and chamfered panels.
    out property <length> radius: 4px;
    out property <length> chamfer: 14px;
    out property <length> page-pad: 22px;
    out property <length> panel-pad: 18px;
    out property <length> gap: 14px;
    out property <length> control-height: 36px;

    // Type: Oxanium (bundled) for the HUD voice, the platform sans for prose.
    out property <string> display: "Oxanium";
    out property <length> font-small: 12px;
    out property <length> font-body: 14px;
    out property <length> font-label: 12px;
    out property <length> font-title: 21px;
    out property <length> font-hero: 54px;
    out property <length> label-tracking: 1.6px;
}
